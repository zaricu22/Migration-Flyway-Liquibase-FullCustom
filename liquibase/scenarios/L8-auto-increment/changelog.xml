<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- autoIncrement="true" -> PostgreSQL GENERATED BY DEFAULT AS IDENTITY, MySQL AUTO_INCREMENT,
         SQL Server IDENTITY(start, step).
         No incrementBy: Liquibase rejects it on MySQL ("incrementBy is not allowed on mysql"), where
         the step is a SERVER-wide setting (auto_increment_increment), not a column property. -->
    <changeSet id="1-create-invoice" author="demo">
        <createTable tableName="invoice">
            <column name="id" type="bigint" autoIncrement="true" startWith="1000">
                <constraints primaryKey="true"/>
            </column>
            <column name="note" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="2-insert-invoices" author="demo">
        <insert tableName="invoice"><column name="note" value="first"/></insert>
        <insert tableName="invoice"><column name="note" value="second"/></insert>
        <insert tableName="invoice"><column name="note" value="third"/></insert>
    </changeSet>

    <!-- Sequences: PostgreSQL and SQL Server have them, MySQL doesn't.
         valueSequenceNext generates nextval('seq') / NEXT VALUE FOR seq. -->
    <changeSet id="3-sequence" author="demo" dbms="postgresql, mssql">
        <createSequence sequenceName="document_number_seq" startValue="5000"/>
        <createTable tableName="document">
            <column name="number" type="bigint">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="varchar(50)"/>
        </createTable>
        <insert tableName="document">
            <column name="number" valueSequenceNext="document_number_seq"/>
            <column name="title" value="numbered by a sequence"/>
        </insert>
    </changeSet>

    <!-- Turning an EXISTING column into an auto-increment column.
         SQL Server can't add IDENTITY to an existing column (Liquibase refuses: "not supported on mssql").
         There you'd create a new table/column and copy the data. -->
    <changeSet id="4-add-auto-increment-later" author="demo" dbms="postgresql, mysql">
        <createTable tableName="legacy_counter">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="note" type="varchar(20)"/>
        </createTable>
        <addAutoIncrement tableName="legacy_counter" columnName="id" columnDataType="bigint" startWith="100"/>
    </changeSet>
</databaseChangeLog>
