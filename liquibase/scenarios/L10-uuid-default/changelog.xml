<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- A database-generated UUID default: three different functions, and MySQL requires the
         parentheses of an "expression default" (8.0.13+). -->
    <property name="uuid_default" value="gen_random_uuid()" dbms="postgresql"/>
    <property name="uuid_default" value="(UUID())"          dbms="mysql"/>
    <property name="uuid_default" value="NEWID()"           dbms="mssql"/>

    <changeSet id="1-create-session-token" author="demo">
        <createTable tableName="session_token">
            <column name="id" type="uuid" defaultValueComputed="${uuid_default}">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_name" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <!-- SQL Server extra: NEWSEQUENTIALID() gives index-friendly, ever-increasing values,
         but it is ONLY allowed as a column default (not in SELECT or INSERT). -->
    <changeSet id="2-sequential-uuid-mssql" author="demo" dbms="mssql">
        <createTable tableName="session_token_sequential">
            <column name="id" type="uuid" defaultValueComputed="NEWSEQUENTIALID()">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_name" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="3-insert-without-id" author="demo">
        <insert tableName="session_token"><column name="user_name" value="ana"/></insert>
        <insert tableName="session_token"><column name="user_name" value="marko"/></insert>
        <insert tableName="session_token"><column name="user_name" value="ivan"/></insert>
    </changeSet>
</databaseChangeLog>
