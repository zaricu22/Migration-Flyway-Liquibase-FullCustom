<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- WHAT GOES WRONG: a raw SQL changeset without a rollback block can't be rolled back. -->
    <changeSet id="1-create-audit-note" author="demo">
        <createTable tableName="audit_note">
            <column name="id" type="int"><constraints primaryKey="true"/></column>
            <column name="note" type="varchar(100)"/>
        </createTable>
    </changeSet>

    <changeSet id="2-tag-v1" author="demo">
        <tagDatabase tag="v1"/>
    </changeSet>

    <!-- No rollback block: a rollback to tag v1 fails, nothing after the tag can be undone automatically. -->
    <changeSet id="3-raw-sql-without-rollback" author="demo">
        <sql>INSERT INTO audit_note (id, note) VALUES (1, 'written by raw SQL')</sql>
    </changeSet>
</databaseChangeLog>
