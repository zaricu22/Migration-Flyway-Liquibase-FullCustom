<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ANTI-PATTERN: two DDL statements in one changeset, and the second one fails
         (FK to a table that doesn't exist).
           PostgreSQL, SQL Server: DDL is transactional -> the whole changeset rolls back, ledger is gone too.
           MySQL: every DDL statement COMMITS IMPLICITLY -> ledger stays, the changeset is not recorded,
                  and the next run fails with "Table 'ledger' already exists". Stuck until fixed by hand. -->
    <changeSet id="1-create-ledger-tables" author="demo">
        <createTable tableName="ledger">
            <column name="id" type="int"><constraints primaryKey="true"/></column>
            <column name="name" type="varchar(50)"/>
        </createTable>
        <createTable tableName="ledger_entry">
            <column name="id" type="int"><constraints primaryKey="true"/></column>
            <column name="account_id" type="int">
                <constraints foreignKeyName="fk_entry_account"
                             referencedTableName="account_that_does_not_exist" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
