<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- THE PORTABLE PATTERN (see failure-demo.xml for what goes wrong without it):
           1. ONE DDL statement per changeset. If it fails, nothing of THIS changeset exists on any
              engine, and everything before it is recorded as executed.
           2. A precondition makes each changeset safe to re-run after a partial manual fix
              (MARK_RAN = "already there, record it and move on"). -->
    <changeSet id="1-create-ledger" author="demo">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="ledger"/></not>
        </preConditions>
        <createTable tableName="ledger">
            <column name="id" type="int"><constraints primaryKey="true"/></column>
            <column name="name" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="2-create-ledger-entry" author="demo">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="ledger_entry"/></not>
        </preConditions>
        <createTable tableName="ledger_entry">
            <column name="id" type="int"><constraints primaryKey="true"/></column>
            <column name="ledger_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_entry_ledger"
                             referencedTableName="ledger" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <!-- DML may be grouped: INSERT/UPDATE are transactional on all three engines. -->
    <changeSet id="3-seed-ledger" author="demo">
        <insert tableName="ledger">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="main"/>
        </insert>
        <insert tableName="ledger_entry">
            <column name="id" valueNumeric="1"/>
            <column name="ledger_id" valueNumeric="1"/>
        </insert>
    </changeSet>
</databaseChangeLog>
