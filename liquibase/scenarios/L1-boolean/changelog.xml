<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Portable: the abstract type "boolean" + valueBoolean/defaultValueBoolean.
         Liquibase picks the engine's type AND the engine's literal (true / 1 / b'1'). -->
    <changeSet id="1-create-feature-flag" author="demo">
        <createTable tableName="feature_flag">
            <column name="id" type="int">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2-insert-flags" author="demo">
        <insert tableName="feature_flag">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="dark_mode"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="feature_flag">
            <column name="id" valueNumeric="2"/>
            <column name="name" value="beta_checkout"/>
        </insert>
        <insert tableName="feature_flag">
            <column name="id" valueNumeric="3"/>
            <column name="name" value="new_search"/>
        </insert>
    </changeSet>

    <!-- Raw SQL is NOT translated: the boolean literal must match the engine.
         TRUE works on PostgreSQL and MySQL (where TRUE is just 1), SQL Server has no TRUE -> 1. -->
    <changeSet id="3-enable-beta-raw-sql" author="demo" dbms="postgresql, mysql">
        <sql>UPDATE feature_flag SET enabled = TRUE WHERE name = 'beta_checkout'</sql>
    </changeSet>
    <changeSet id="3-enable-beta-raw-sql-mssql" author="demo" dbms="mssql">
        <sql>UPDATE feature_flag SET enabled = 1 WHERE name = 'beta_checkout'</sql>
    </changeSet>
</databaseChangeLog>
