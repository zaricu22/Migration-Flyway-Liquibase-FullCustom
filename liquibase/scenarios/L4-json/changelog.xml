<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- The abstract "json" type fails on SQL Server 2022 (no json type until SQL Server 2025).
         -> choose the storage per engine with a property. -->
    <property name="json_type" value="jsonb"         dbms="postgresql"/>
    <property name="json_type" value="json"          dbms="mysql"/>
    <property name="json_type" value="nvarchar(max)" dbms="mssql"/>

    <changeSet id="1-create-event" author="demo">
        <createTable tableName="event">
            <column name="id" type="int">
                <constraints primaryKey="true"/>
            </column>
            <column name="payload" type="${json_type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- SQL Server stores plain text: only a CHECK with ISJSON() rejects invalid documents. -->
    <changeSet id="2-mssql-json-check" author="demo" dbms="mssql">
        <sql>ALTER TABLE event ADD CONSTRAINT ck_event_payload_is_json CHECK (ISJSON(payload) = 1)</sql>
    </changeSet>

    <changeSet id="3-insert-events" author="demo">
        <insert tableName="event">
            <column name="id" valueNumeric="1"/>
            <column name="payload" value='{"type": "login", "user": {"id": 7, "name": "Ana"}, "tags": ["web", "mobile"]}'/>
        </insert>
        <insert tableName="event">
            <column name="id" valueNumeric="2"/>
            <column name="payload" value='{"type": "purchase", "user": {"id": 9, "name": "Marko"}, "amount": 49.90}'/>
        </insert>
    </changeSet>

    <!-- Reading a nested field: three different syntaxes -> one createView per engine. -->
    <changeSet id="4-view-event-user-postgresql" author="demo" dbms="postgresql">
        <createView viewName="event_user">
            SELECT id, payload ->> 'type' AS event_type, payload -> 'user' ->> 'name' AS user_name
            FROM event
        </createView>
    </changeSet>
    <changeSet id="4-view-event-user-mysql" author="demo" dbms="mysql">
        <createView viewName="event_user">
            SELECT id, payload ->> '$.type' AS event_type, payload ->> '$.user.name' AS user_name
            FROM event
        </createView>
    </changeSet>
    <changeSet id="4-view-event-user-mssql" author="demo" dbms="mssql">
        <createView viewName="event_user">
            SELECT id, JSON_VALUE(payload, '$.type') AS event_type, JSON_VALUE(payload, '$.user.name') AS user_name
            FROM event
        </createView>
    </changeSet>
</databaseChangeLog>
