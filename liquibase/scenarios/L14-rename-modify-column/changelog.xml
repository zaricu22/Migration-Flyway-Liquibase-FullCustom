<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Two identical tables. Both get the same rename + type change;
         only "person" gets the follow-up fixes. Compare them afterwards. -->
    <changeSet id="1-create-tables" author="demo">
        <createTable tableName="person_naive">
            <column name="id" type="int"><constraints primaryKey="true"/></column>
            <column name="surname" type="varchar(50)" defaultValue="unknown"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="person">
            <column name="id" type="int"><constraints primaryKey="true"/></column>
            <column name="surname" type="varchar(50)" defaultValue="unknown"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <!-- renameColumn: PostgreSQL/SQL Server rename in place (RENAME COLUMN / sp_rename).
         MySQL: Liquibase needs columnDataType because it generates "CHANGE old new <full definition>". -->
    <changeSet id="2-rename-column" author="demo">
        <renameColumn tableName="person_naive" oldColumnName="surname" newColumnName="last_name" columnDataType="varchar(50)"/>
        <renameColumn tableName="person"       oldColumnName="surname" newColumnName="last_name" columnDataType="varchar(50)"/>
    </changeSet>

    <!-- modifyDataType: widen varchar(50) -> varchar(100).
           PostgreSQL  ALTER COLUMN ... TYPE         keeps NOT NULL and DEFAULT
           MySQL       MODIFY ... VARCHAR(100)        REDEFINES the column: NOT NULL and DEFAULT are gone
           SQL Server  ALTER COLUMN ... varchar(100)  NOT NULL is gone (default constraint survives) -->
    <changeSet id="3-widen-column" author="demo">
        <modifyDataType tableName="person_naive" columnName="last_name" newDataType="varchar(100)"/>
        <modifyDataType tableName="person"       columnName="last_name" newDataType="varchar(100)"/>
    </changeSet>

    <!-- The fix, portable: restate what the engine may have dropped.
         addNotNullConstraint needs columnDataType on MySQL and SQL Server (both redefine the column). -->
    <changeSet id="4-restore-not-null" author="demo">
        <addNotNullConstraint tableName="person" columnName="last_name" columnDataType="varchar(100)" defaultNullValue="unknown"/>
    </changeSet>

    <!-- The default only got lost on MySQL (SQL Server keeps its separate default constraint,
         re-adding it there would fail with "column already has a DEFAULT"). -->
    <changeSet id="5-restore-default-mysql" author="demo" dbms="mysql">
        <addDefaultValue tableName="person" columnName="last_name" columnDataType="varchar(100)" defaultValue="unknown"/>
    </changeSet>
</databaseChangeLog>
